    "family.difficulty.footer" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic changes the level between games, never during one: up after strong games, down after a hard one. A level you choose stays until you switch back to Automatic, which then continues from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La automática cambia el nivel entre partidas, nunca durante una: sube tras partidas muy buenas y baja tras una difícil. Un nivel que elijas se mantiene hasta que vuelvas a Automática, que sigue desde ese nivel."
          }
        }
      }
    },
