    "about.build" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app was built with the help of AI coding assistants, including Meta's Muse Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se creó con ayuda de asistentes de programación con IA, entre ellos Muse Code de Meta."
          }
        }
      }
    },
    "about.offline" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing in the app uses AI while you play. Your games and photos stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en la app usa IA mientras juegas. Tus partidas y fotos se quedan en este dispositivo."
          }
        }
      }
    },
    "about.pictures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pictures in this app were made with AI image tools, including Meta's Muse Image, and checked by a person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes de esta app se hicieron con herramientas de IA, entre ellas Muse Image de Meta, y las revisó una persona."
          }
        }
      }
    },
