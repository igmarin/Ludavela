    "why.research.bundle" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One large study of people aged 60 to 77 looked at games together with food, movement and a healthy routine, not games alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un estudio grande con personas de 60 a 77 años miró los juegos junto con la comida, el movimiento y una rutina sana, no los juegos solos."
          }
        }
      }
    },
    "why.research.promise" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So we promise you nothing. We offer pleasant mental exercise, at your pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por eso no te prometemos nada. Te ofrecemos un ejercicio mental agradable, a tu ritmo."
          }
        }
      }
    },
    "why.research.small" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In studies of older adults, computer games led to small gains, mostly on the very tasks people practised."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En estudios con personas mayores, los juegos de computadora dieron pequeños avances, sobre todo en las mismas tareas que se practicaron."
          }
        }
      }
    },
    "why.research.stanford" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 2014, about 70 scientists wrote that there is \"no compelling scientific evidence\" for what brain games promise in daily life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En 2014, unos 70 científicos escribieron que \"no hay pruebas científicas convincentes\" de lo que los juegos mentales prometen en la vida diaria."
          }
        }
      }
    },
    "why.research.title" : {
      "extractionState" : "stale",
